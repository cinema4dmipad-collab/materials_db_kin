# База данных
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=123456
DB_HOST=localhost
DB_PORT=5432
DB_ENGINE=postgresql

# Django
SECRET_KEY=django-insecure-temporary-key-for-dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Логирование
LOG_LEVEL=INFO

# S3 Storage (SeaweedFS / MinIO / AWS)
USE_S3=true
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=secret
AWS_STORAGE_BUCKET_NAME=materials-db-v1
AWS_S3_ENDPOINT_URL=http://localhost:9993
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path