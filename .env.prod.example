# Production .env для Dokploy / docker-compose.prod.yml
#
# Использование на сервере:
#   cp .env.prod.example .env
#   # заполните секреты и hostnames сервисов Dokploy
#   docker compose -f docker-compose.prod.yml up -d
#
# Важно:
#   - Имена переменных совпадают с config/settings.py (без префикса DJANGO_).
#   - НЕ используйте DATABASE_URL, DJANGO_SECRET_KEY, DJANGO_DEBUG,
#     DJANGO_SETTINGS_MODULE — приложение их не читает.
#   - WSGI по умолчанию: config.settings (см. config/wsgi.py).
#
# Hostnames DB_HOST и AWS_S3_ENDPOINT_URL — внутренние имена контейнеров
# в общей Docker-сети Dokploy (Services → ваш сервис → Network / Internal URL).
# Не используйте host.docker.internal и не пробрасывайте порты наружу для связи
# между контейнерами.

# --- Docker image (обязательно для docker-compose.prod.yml) ---
WEB_IMAGE=registry.example.com/group/materials-db-v1:latest

# --- База данных (внешний Postgres в Dokploy) ---
DB_ENGINE=postgresql
DB_HOST=materialsdb-postgres-xxxxx
DB_PORT=5432
DB_NAME=materials_db
DB_USER=django
DB_PASSWORD=change-me-strong-db-password
DB_WAIT_TIMEOUT=120

# --- Django ---
# Сгенерируйте: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=False

# IP сервера и/или домен; через запятую без пробелов
ALLOWED_HOSTS=192.168.221.40,localhost,127.0.0.1

# Схема + хост (без слэша в конце); при HTTPS добавьте https://your-domain
CSRF_TRUSTED_ORIGINS=http://192.168.221.40

# HTTP без TLS (внутренняя сеть / IP): false
# При HTTPS через reverse proxy: true + SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false

# --- Gunicorn (HDF5 до 20 ГБ — длинный timeout) ---
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=3600
GUNICORN_GRACEFUL_TIMEOUT=3600
GUNICORN_KEEPALIVE=5
GUNICORN_LOG_LEVEL=info

# --- S3 / SeaweedFS (внешний сервис в Dokploy) ---
USE_S3=true
AWS_ACCESS_KEY_ID=change-me-s3-access-key
AWS_SECRET_ACCESS_KEY=change-me-s3-secret-key
AWS_STORAGE_BUCKET_NAME=materials-db
# Внутренний URL S3 API SeaweedFS (порт 8333), не публичный IP
AWS_S3_ENDPOINT_URL=http://seaweedfs:8333
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_VERIFY=false

# --- Nginx (docker-compose.prod.yml) ---
# Порт на хосте; в Dokploy маршрут :80 часто настраивается отдельно (Domain → nginx:80)
NGINX_HTTP_PORT=80
