# Production .env для Dokploy / docker-compose.prod.yml
#
# Использование на сервере:
#   cp .env.prod.example .env
#   # заполните секреты и hostnames сервисов Dokploy
#   docker compose -f docker-compose.prod.yml up -d
#
# Важно:
#   - Имена переменных совпадают с config/settings.py (без префикса DJANGO_).
#   - НЕ используйте DATABASE_URL, DJANGO_SECRET_KEY, DJANGO_DEBUG,
#     DJANGO_SETTINGS_MODULE — приложение их не читает.
#   - WSGI по умолчанию: config.settings (см. config/wsgi.py).
#
# Hostnames DB_HOST и AWS_S3_ENDPOINT_URL — внутренние имена контейнеров
# в общей Docker-сети Dokploy (Services → ваш сервис → Network / Internal URL).
# Не используйте host.docker.internal и не пробрасывайте порты наружу для связи
# между контейнерами.

# --- Docker image (локальная сборка на сервере Dokploy) ---
# Теги БЕЗ registry — только локальные имена после docker compose build.
# Не используйте materials-db-web:abc1234 без сборки: Docker Hub такого repo не имеет.
#
# Рекомендуется для Dokploy:
#   WEB_IMAGE=materials-db-web:prod
#   NGINX_IMAGE=materials-db-nginx:prod
# compose соберёт образы из Dockerfile при каждом deploy (pull_policy: build).
#
# Если образы приходят из GitLab registry (CI), укажите ПОЛНЫЙ путь + login:
#   WEB_IMAGE=registry.gitlab.keeneticcorp.ru/development/applications/materials_db_strict:abc1234
# и отключите build в Dokploy / используйте отдельный compose без build-секций.

# --- База данных (внешний Postgres в Dokploy) ---
DB_ENGINE=postgresql
DB_HOST=materialsdb-postgres-xxxxx
DB_PORT=5432
DB_NAME=materials_db
DB_USER=django
DB_PASSWORD=change-me-strong-db-password
DB_WAIT_TIMEOUT=120
# Каталог PostgreSQL-бэкапов внутри Docker volume.
BACKUP_DIR=/backups
# BACKUP_UPLOAD_MAX_BYTES=536870912

# --- Django ---
# Сгенерируйте: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Git commit на /debug/ записывается в образ при сборке (файл /app/BUILD_COMMIT).
# В runtime .env GIT_COMMIT не нужен.
#
# Dokploy: поле Command — ОСТАВИТЬ ПУСТЫМ. Подробно: deploy/DOKPLOY.md
#
# После смены настроек — redeploy с rebuild (не только restart).
# Если Git commit на /debug/ пустой: BUILD_CACHE_BUST=2 в env Dokploy или build --no-cache web.
# Major pg_dump в образе (должен быть >= версии Postgres на сервере; стенд 18.x → 18):
# POSTGRES_CLIENT_MAJOR=18
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=False

# IP сервера и/или домен; через запятую без пробелов
ALLOWED_HOSTS=192.168.221.40,localhost,127.0.0.1

# Схема + хост (без слэша в конце); при HTTPS добавьте https://your-domain
CSRF_TRUSTED_ORIGINS=http://192.168.221.40

# HTTP без TLS (внутренняя сеть / IP): false
# При HTTPS через reverse proxy: true + SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false

# --- Gunicorn (HDF5 до 20 ГБ — длинный timeout) ---
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=3600
GUNICORN_GRACEFUL_TIMEOUT=3600
GUNICORN_KEEPALIVE=5
GUNICORN_LOG_LEVEL=info

# --- S3 / SeaweedFS (внешний сервис в Dokploy) ---
USE_S3=true
# Должны совпадать с .env SeaweedFS (docker-compose.storage.yml)
AWS_ACCESS_KEY_ID=seaweedfs
AWS_SECRET_ACCESS_KEY=seaweedfs
AWS_STORAGE_BUCKET_NAME=materials-db
# Внутренний URL S3 API SeaweedFS (порт 8333), не публичный IP
AWS_S3_ENDPOINT_URL=http://seaweedfs:8333
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_VERIFY=false

# --- Debug: ссылки на веб-UI SeaweedFS (для браузера оператора) ---
# Задаются в env сервиса **web** (Django), НЕ в compose хранилища.
# IP/домен, с которого открываете приложение в браузере (не seaweedfs:8333).
DEBUG_S3_ADMIN_BASE_URL=http://192.168.221.40
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_ADMIN_PORT=23646
SEAWEEDFS_S3_PORT=8333

# --- Nginx (docker-compose.prod.yml) ---
# Порт на хосте; в Dokploy маршрут :80 часто настраивается отдельно (Domain → nginx:80)
NGINX_HTTP_PORT=80
