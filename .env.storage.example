# SeaweedFS — docker-compose.storage.yml
# cp .env.storage.example .env

# Имя контейнера (Django подключается по hostname сервиса в Dokploy)
SEAWEEDFS_CONTAINER_NAME=seaweedfs
SEAWEEDFS_IMAGE_TAG=latest

# S3 credentials — скопируйте те же значения в .env Django-приложения (Dokploy)
# Если не заданы — compose использует дефолт seaweedfs / seaweedfs
AWS_ACCESS_KEY_ID=seaweedfs
AWS_SECRET_ACCESS_KEY=seaweedfs
AWS_STORAGE_BUCKET_NAME=materials-db

# Порты на хосте (в Dokploy опубликуйте нужные)
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_ADMIN_PORT=23646
