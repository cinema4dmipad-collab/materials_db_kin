# Скопируйте в .env и подставьте свои значения.
# Для docker compose: cp .env.example .env && docker compose up -d --build

# --- База данных ---
# Локально: DB_HOST=localhost
# Docker Compose переопределяет DB_HOST=postgres в docker-compose.yml
DB_NAME=materials_db
DB_USER=materials
DB_PASSWORD=change-me-db
DB_HOST=localhost
DB_PORT=5432
DB_ENGINE=postgresql
DB_WAIT_TIMEOUT=60
# Каталог PostgreSQL-бэкапов внутри Docker volume.
BACKUP_DIR=/backups

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
# Локальная разработка: DEBUG=True
# Прод / docker: DEBUG=False
DEBUG=False
# Откат последнего импорта одной кнопкой (по умолчанию совпадает с DEBUG).
# На стенде без полного DEBUG: IMPORT_BATCH_UNDO=true
# IMPORT_BATCH_UNDO=false
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false

LOG_LEVEL=INFO

# --- Gunicorn (HDF5 до 20 ГБ — длинный timeout) ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=3600

# --- S3 / SeaweedFS ---
# Локально без S3: USE_S3=false и пустой bucket
# Docker Compose: USE_S3=true, endpoint переопределяется на http://seaweedfs:8333
USE_S3=true
AWS_ACCESS_KEY_ID=seaweedfs
AWS_SECRET_ACCESS_KEY=seaweedfs
AWS_STORAGE_BUCKET_NAME=materials-db
AWS_S3_ENDPOINT_URL=http://localhost:8333
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_VERIFY=false

# Ссылки на Filer / Master / Admin в /debug/ (хост, доступный из браузера)
# DEBUG_S3_ADMIN_BASE_URL=http://localhost
NGINX_HTTP_PORT=80
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_FILER_PORT=8888

# --- Сборка Docker / зеркала ---
# Если Docker Hub нестабилен, можно указать совместимый mirror-образ:
# PYTHON_IMAGE=mirror.example.com/library/python:3.13-slim-bookworm
PYTHON_IMAGE=python:3.13-slim-bookworm
# Если PyPI нестабилен, можно зафиксировать одно зеркало:
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple/
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
# Или переопределить список зеркал для автоподбора:
# PIP_MIRROR_URLS=https://pypi.tuna.tsinghua.edu.cn/simple/ https://mirrors.aliyun.com/pypi/simple/

# --- Prod deploy (GitLab CI / Dokploy / внешний сервер) ---
# Полный шаблон для продакшена: см. .env.prod.example
#   cp .env.prod.example .env   # на сервере, затем заполнить секреты
#   docker compose -f docker-compose.prod.yml up -d
#
# Отдельное S3-хранилище: docker-compose.storage.yml + .env.storage.example
