# Скопируйте в .env и подставьте свои значения.
# Для docker compose: cp .env.example .env && docker compose up -d --build

# --- База данных ---
# Локально: DB_HOST=localhost
# Docker Compose переопределяет DB_HOST=postgres в docker-compose.yml
DB_NAME=materials_db
DB_USER=materials
DB_PASSWORD=change-me-db
DB_HOST=localhost
DB_PORT=5432
DB_ENGINE=postgresql
DB_WAIT_TIMEOUT=60

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
# Локальная разработка: DEBUG=True
# Прод / docker: DEBUG=False
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false

LOG_LEVEL=INFO

# --- Gunicorn (HDF5 до 20 ГБ — длинный timeout) ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=3600

# --- S3 / MinIO ---
# Локально без S3: USE_S3=false и пустой bucket
# Docker Compose: USE_S3=true, endpoint переопределяется на http://minio:9000
USE_S3=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=materials-db
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_VERIFY=false

# --- Порты docker compose на хосте ---
NGINX_HTTP_PORT=80
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
