              {"key": "X-Workspace-Id", "value": "not-a-uuid"}
            ],
            "url": "{{baseUrl}}/api/v1/materials/"
          }
        },
        {
          "name": "materials unknown workspace 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code should be 404', function () {",
                  "  pm.expect(pm.response.code, 'Unknown/inaccessible workspace must return 404 (not 403)').to.eql(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {"key": "X-Workspace-Id", "value": "00000000-0000-0000-0000-000000000000"}
            ],
