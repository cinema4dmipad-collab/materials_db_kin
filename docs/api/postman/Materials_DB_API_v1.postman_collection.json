                "exec": [
                  "pm.test('Status code should be 404', function () {",
                  "  pm.expect(pm.response.code, 'Missing material id must return 404').to.eql(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {"key": "X-Workspace-Id", "value": "{{workspaceId}}"}
            ],
            "url": "{{baseUrl}}/api/v1/materials/00000000-0000-0000-0000-000000000000/"
          }
        }
      ]
    }
  ]
}
